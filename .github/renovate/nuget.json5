{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  packageRules: [
    {
      matchManagers: ["nuget"],
      matchUpdateTypes: ["patch"],
    },
    {
      matchManagers: ["nuget"],
      matchUpdateTypes: ["minor"],
      automerge: false,
    },
    {
      matchManagers: ["nuget"],
      matchUpdateTypes: ["major"],
      automerge: false,
      minimumReleaseAge: "7 days",
    },
    {
      matchManagers: ["nuget"],
      matchPackagePatterns: ["^Jellyfin\\."],
      groupName: "Jellyfin packages",
      automerge: false,
    },
    {
      // These versions must move together with the target framework, ABI,
      // release metadata, and compatibility matrix.
      matchManagers: ["nuget"],
      matchPackageNames: [
        "Jellyfin.Controller",
        "Jellyfin.Model",
        "Microsoft.Extensions.Hosting.Abstractions",
      ],
      enabled: false,
    },
  ],
}
